{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-cli.local/schema/adapter.schema.json",
  "title": "multi-cli adapter",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "kind",
    "binary",
    "isolation"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "default": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "cli",
        "ide",
        "gui",
        "hybrid"
      ]
    },
    "binary": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "windows",
          "macos",
          "linux"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "exec",
            "stdio",
            "http",
            "acp",
            "websocket"
          ]
        },
        "stdio": {
          "$ref": "#/$defs/protocolStdio"
        },
        "http": {
          "$ref": "#/$defs/protocolHttp"
        },
        "acp": {
          "$ref": "#/$defs/protocolAcp"
        },
        "websocket": {
          "$ref": "#/$defs/protocolWebSocket"
        }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "env",
            "userDataDir",
            "redirectHome",
            "appdata",
            "sandboxUser",
            "accountOverlay"
          ]
        },
        "mode": {
          "enum": [
            "foreground",
            "detached"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "clearEnv": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shareFromRealHome": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "required": [
        "mechanism"
      ],
      "properties": {
        "mechanism": {
          "enum": [
            "processSecret",
            "fileOverlay",
            "osUserCredentialStore",
            "inseparable"
          ]
        },
        "credentialFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "credentialPrecedence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "logoutScope": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "secret": {
          "type": "object",
          "required": [
            "environmentVariable"
          ],
          "properties": {
            "environmentVariable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "normalState": {
      "type": "object",
      "required": [
        "root",
        "sharedPaths",
        "sessionPaths",
        "unsafePaths"
      ],
      "properties": {
        "root": {
          "type": "object",
          "required": [
            "windows",
            "macos",
            "linux"
          ],
          "properties": {
            "windows": {
              "type": "string",
              "minLength": 1
            },
            "macos": {
              "type": "string",
              "minLength": 1
            },
            "linux": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "runtimeSubdir": {
          "$ref": "#/$defs/relativePath"
        },
        "sharedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "sessionPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "filePaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "unsafePaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "required": [
        "level",
        "singletonScope"
      ],
      "properties": {
        "level": {
          "enum": [
            "multiWriter",
            "singleWriter",
            "unsupported"
          ]
        },
        "singletonScope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "required": [
        "windows",
        "macos",
        "linux"
      ],
      "properties": {
        "windows": {
          "$ref": "#/$defs/support"
        },
        "macos": {
          "$ref": "#/$defs/support"
        },
        "linux": {
          "$ref": "#/$defs/support"
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "string",
      "minLength": 1
    },
    "versionCommand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "share": {
      "$ref": "#/$defs/legacyShare"
    },
    "session": {
      "$ref": "#/$defs/legacySession"
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "legacyShare": {
      "type": "object",
      "properties": {
        "systemHome": {
          "type": "string",
          "minLength": 1
        },
        "linkable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "neverLink": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "additionalProperties": false
    },
    "legacySession": {
      "type": "object",
      "properties": {
        "portable": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "resumeHint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^[/\\\\]"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)"
          }
        ]
      }
    },
    "support": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "protocolStdio": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "messageFormat": {
          "enum": ["jsonrpc", "newline-delimited-json", "raw"]
        },
        "newlineDelimited": {
          "type": "boolean"
        },
        "healthCheck": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["initialize", "ready", "none"]
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "clientEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "clientCommand": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "protocolHttp": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "port": {
          "type": "object",
          "properties": {
            "strategy": {
              "enum": ["dynamic", "fixed", "range"]
            },
            "preferred": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "range": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        },
        "bindAddress": {
          "type": "string",
          "minLength": 1
        },
        "healthCheck": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "method": {
              "enum": ["GET", "POST"]
            },
            "expectedStatus": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "intervalMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "clientEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "clientCommand": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "shutdown": {
          "type": "object",
          "properties": {
            "method": {
              "enum": ["sigterm", "sigkill", "http"]
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "protocolAcp": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "transport": {
          "enum": ["stdio", "unix-socket", "tcp"]
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "handshake": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["initialize", "ready", "none"]
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "clientEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "clientCommand": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "socket": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["unix", "tcp"]
            },
            "path": { "type": "string", "minLength": 1 },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "protocolWebSocket": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "port": {
          "type": "object",
          "properties": {
            "strategy": {
              "enum": ["dynamic", "fixed", "range"]
            },
            "preferred": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "range": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        },
        "bindAddress": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "healthCheck": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["http", "connect", "none"]
            },
            "path": { "type": "string", "minLength": 1 },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "intervalMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "clientEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "clientCommand": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "shutdown": {
          "type": "object",
          "properties": {
            "method": {
              "enum": ["sigterm", "sigkill", "close"]
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "account",
          "normalState",
          "concurrency",
          "support"
        ],
        "properties": {
          "isolation": {
            "required": [
              "strategy",
              "mode"
            ],
            "properties": {
              "strategy": {
                "const": "accountOverlay"
              },
              "shareFromRealHome": false
            }
          },
          "share": false,
          "session": false,
          "status": false
        }
      },
      "else": {
        "properties": {
          "account": false,
          "normalState": false,
          "concurrency": false,
          "support": false
        }
      }
    }
  ]
}
